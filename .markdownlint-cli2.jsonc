// Structural linting for every Markdown file in the repo — the docs site, the
// root README, and the contributor policies.
//
// Scope note: this checks *structure*, not prose. It catches the things that
// render wrong or read wrong in a diff — malformed tables, skipped heading
// levels, list indentation that silently changes nesting, unclosed fences. It
// deliberately has no opinion on wording.
{
  // .mdx too: Docusaurus pages can use either extension, and a page that
  // switches to .mdx should not silently drop out of the lint scope.
  "globs": ["**/*.md", "**/*.mdx"],

  // Without this, the scan walks straight into gitignored working directories
  // — local scratch notes, .claude, the stale objstore-website/node_modules —
  // and reports failures for files that are not part of the project.
  "gitignore": true,

  "ignores": [
    "**/node_modules/**",
    "website/build/**",
    "website/.docusaurus/**",

    // Assembled from GitHub's auto-generated release notes, which emit bare
    // "by @user in <url>" lines. Those trip MD034, and since the generator
    // produces them fresh every release, gating on it would mean hand-editing
    // the changelog after each tag forever. GitHub and Docusaurus both
    // autolink bare URLs, so the reader loses nothing.
    "CHANGELOG.md"
  ],

  "config": {
    "default": true,

    // Prose here is hand-wrapped at 80, but tables, long links, and Go
    // identifiers in code spans routinely exceed it and cannot be wrapped
    // without breaking what they mean. Enforcing a column limit would mean
    // reflowing tables into something less readable to satisfy a linter, so
    // the wrapping stays a convention rather than a gate.
    "MD013": false,

    // Docusaurus pages carry the page title in front matter, then open with an
    // `# Heading`. Without this both rules read that as a second/missing h1.
    "MD025": { "front_matter_title": "" },
    "MD041": { "front_matter_title": "" },

    // API reference pages repeat the same section name under different
    // symbols — several `### Parameters` on one page is correct structure, not
    // a mistake. Only flag a duplicate among direct siblings.
    "MD024": { "siblings_only": true },

    // The centred README header (logo, badges, tagline) has no Markdown
    // equivalent. Allow the presentational tags actually in use and keep the
    // rule on, so anything beyond this list still gets flagged.
    "MD033": {
      "allowed_elements": [
        "a",
        "b",
        "br",
        "details",
        "div",
        "h1",
        "img",
        "p",
        "picture",
        "source",
        "summary"
      ]
    }
  }
}
